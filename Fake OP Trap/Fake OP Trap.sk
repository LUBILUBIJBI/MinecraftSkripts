command /getcreative:
    aliases: /getop, /getoploot, /claimloot
    trigger:
        # Broadcast message to everyone
        broadcast "&8[&6AntiCheat&8] &e%player% &7tried to CHEAT. &c&lSHAME!"
        
        # Punishment
        kill player
        
        # Sound effect
        play sound "entity.generic.explode" with volume 1 and pitch 1 to all players