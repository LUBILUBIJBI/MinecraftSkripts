# =======================================================
# LEGENDARY SWORDS SYSTEM (v1.26.2)
# Includes One-Time Weapon Core System (Heart of the Sea), /lws & /resetswords
# =======================================================

# =======================================================
# 1. ADMIN COMMAND: /lws (STATUS OF ALL SWORDS)
# =======================================================

command /lws:
    trigger:
        send "&e&l=== LEGENDARY SWORDS STATUS ===" to player
        
        if {crafted.yeti} is set:
            send "&7- Sword of Yeti: &c[CRAFTED]" to player
        else:
            send "&7- Sword of Yeti: &a[AVAILABLE]" to player
            
        if {crafted.berserker} is set:
            send "&7- Axe of Berserker: &c[CRAFTED]" to player
        else:
            send "&7- Axe of Berserker: &a[AVAILABLE]" to player
            
        if {crafted.tornado} is set:
            send "&7- Tornado: &c[CRAFTED]" to player
        else:
            send "&7- Tornado: &a[AVAILABLE]" to player
            
        if {crafted.rost} is set:
            send "&7- Rust: &c[CRAFTED]" to player
        else:
            send "&7- Rust: &a[AVAILABLE]" to player
            
        if {crafted.engel} is set:
            send "&7- Angel Sword: &c[CRAFTED]" to player
        else:
            send "&7- Angel Sword: &a[AVAILABLE]" to player
            
        if {crafted.spider} is set:
            send "&7- Spider: &c[CRAFTED]" to player
        else:
            send "&7- Spider: &a[AVAILABLE]" to player
            
        if {crafted.baguette} is set:
            send "&7- Baguette: &c[CRAFTED]" to player
        else:
            send "&7- Baguette: &a[AVAILABLE]" to player
            
        if {crafted.spion} is set:
            send "&7- Spy: &c[CRAFTED]" to player
        else:
            send "&7- Spy: &a[AVAILABLE]" to player
            
        if {crafted.blut} is set:
            send "&7- Sword of Blood: &c[CRAFTED]" to player
        else:
            send "&7- Sword of Blood: &a[AVAILABLE]" to player
            
        send "&e&l=================================" to player


# =======================================================
# 2. ADMIN COMMAND: /resetswords (RESET ALL VARIABLES)
# =======================================================

command /resetswords:
    permission: op
    trigger:
        delete {crafted.yeti}
        delete {crafted.berserker}
        delete {crafted.tornado}
        delete {crafted.rost}
        delete {crafted.engel}
        delete {crafted.spider}
        delete {crafted.baguette}
        delete {crafted.spion}
        delete {crafted.blut}
        send "&c[Legendary] All crafting statuses and sword variables have been successfully reset!" to player
        play sound "entity.player.levelup" with volume 1.0 and pitch 0.5 at location of player


# =======================================================
# 3. ADMIN COMMANDS: GIVE CORES (/kern...) [Heart of the Sea]
# =======================================================

command /kernyeti [<player>]:
    permission: op
    trigger:
        set {_target} to player
        if arg-1 is set:
            set {_target} to arg-1
        set {_item} to 1 heart of the sea named "Core of Sword of Yeti"
        set line 1 of lore of {_item} to "&8[Legendary Core]"
        give {_item} to {_target}
        send "&a[Legendary] Core of Sword of Yeti given to &e%{_target}%&a!" to player

